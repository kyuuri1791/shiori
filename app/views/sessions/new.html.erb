<% content_for :title, "ログイン | 読書カード帳" %>
<% content_for :head do %>
  <%= vite_stylesheet_tag "sessions/new/application.scss" %>
<% end %>
<main class="auth">
  <h1 class="auth__title">読書カード帳</h1>
  <%= tag.div(flash[:alert], class: "flash flash--alert") if flash[:alert] %>
  <%= tag.div(flash[:notice], class: "flash") if flash[:notice] %>

  <%= form_with url: session_path, class: "auth__form" do |form| %>
    <%= form.email_field :email_address, class: "auth__input", required: true, autofocus: true, autocomplete: "username", placeholder: "メールアドレス", value: params[:email_address] %>
    <%= form.password_field :password, class: "auth__input", required: true, autocomplete: "current-password", placeholder: "パスワード", maxlength: 72 %>
    <%= form.submit "ログイン", class: "auth__submit" %>
  <% end %>

</main>
