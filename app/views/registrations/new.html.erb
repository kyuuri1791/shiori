<% content_for :title, "ユーザー登録 | 読書カード帳" %>
<% content_for :head do %>
  <%= vite_stylesheet_tag "registrations/new/application.scss" %>
<% end %>
<main class="auth">
  <h1 class="auth__title">読書カード帳</h1>
  <p class="auth__lead">ユーザー登録</p>
  <%= tag.div(flash[:alert], class: "flash flash--alert") if flash[:alert] %>
  <% if @user.errors.any? %>
    <ul class="flash flash--alert auth__errors">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with url: registration_path, class: "auth__form" do |form| %>
    <%= form.email_field :email_address, class: "auth__input", required: true, autofocus: true, autocomplete: "username", placeholder: "メールアドレス", maxlength: 255, value: @user.email_address %>
    <%= form.password_field :password, class: "auth__input", required: true, autocomplete: "new-password", placeholder: "パスワード（#{User::PASSWORD_MIN_LENGTH}文字以上）", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72 %>
    <%= form.password_field :password_confirmation, class: "auth__input", required: true, autocomplete: "new-password", placeholder: "パスワード（確認）", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72 %>
    <%= form.submit "登録する", class: "auth__submit" %>
  <% end %>
  <p class="auth__note">AI の機能は、管理者の承認を受けると使えるようになります。</p>
  <p class="auth__switch">登録済みの方は <%= link_to "ログイン", new_session_path, class: "link" %></p>
</main>
