<% content_for :title, "ユーザー登録 | shiori" %>
<main class="mx-auto mt-[12vh] grid max-w-[380px] gap-3.5 py-7 pr-[max(16px,env(safe-area-inset-right,0px))] pl-[max(16px,env(safe-area-inset-left,0px))]">
  <h1 class="mt-0 mb-1.5 font-display text-[26px] tracking-[.06em]">shiori</h1>
  <p class="m-0 font-medium">ユーザー登録</p>
  <%= tag.div(flash[:alert], class: "banner") if flash[:alert] %>
  <% if @user.errors.any? %>
    <ul class="banner m-0 list-disc pl-7">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with url: registration_path, class: "grid min-w-0 gap-2.5" do |form| %>
    <%= form.email_field :email_address, class: "input-box bg-card px-3 py-2.5", required: true, autofocus: true, autocomplete: "username", placeholder: "メールアドレス", maxlength: 255, value: @user.email_address %>
    <%= form.password_field :password, class: "input-box bg-card px-3 py-2.5", required: true, autocomplete: "new-password", placeholder: "パスワード（#{User::PASSWORD_MIN_LENGTH}文字以上）", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72 %>
    <%= form.password_field :password_confirmation, class: "input-box bg-card px-3 py-2.5", required: true, autocomplete: "new-password", placeholder: "パスワード（確認）", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72 %>
    <%= form.submit "登録する", class: "btn-primary w-full py-2.5" %>
  <% end %>
  <p class="m-0 text-sm text-muted">AI の機能は、管理者の承認を受けると使えるようになります。</p>
  <p class="m-0 text-sm text-muted">登録済みの方は <%= link_to "ログイン", new_session_path, class: "link" %></p>
</main>
