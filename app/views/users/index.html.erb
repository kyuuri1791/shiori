<% content_for :title, "みんなの本棚 | 読書カード帳" %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<div class="page">
  <header class="page-header">
    <h1 class="page-title"><%= link_to "読書カード帳", root_path, class: "text-inherit no-underline" %></h1>
    <div class="page-nav">
      <% if current_user %>
        <%= link_to "自分の本棚", root_path, class: "btn-link" %>
      <% else %>
        <%= link_to "ログイン", new_session_path, class: "btn-link" %>
      <% end %>
    </div>
  </header>

  <section class="grid gap-3" aria-labelledby="user-list-title">
    <h2 class="m-0 font-display text-xl" id="user-list-title">みんなの本棚</h2>
    <% if @users.empty? %>
      <p class="m-0 text-muted">まだ本棚がありません。</p>
    <% else %>
      <ul class="m-0 list-none divide-y divide-line overflow-hidden rounded-[10px] border border-line bg-card p-0">
        <% @users.each do |user| %>
          <li>
            <%= link_to user_path(user), class: "flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-4 py-3.5 text-inherit no-underline hover:bg-paper" do %>
              <span class="font-display text-base font-bold">本棚 #<%= user.id %><% if user.id == current_user&.id %><span class="ml-2 font-sans text-xs font-medium text-accent">あなたの本棚</span><% end %></span>
              <span class="text-[13px] text-muted tabular-nums">
                <%= user.user_shelf_items_count %>冊<% if user.last_added_at %> · 最近の登録 <%= user.last_added_at.to_date.strftime("%Y.%m.%d") %><% end %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <%= render "shared/pager", page: @page, query: {} %>
</div>
