<div class="page">
  <%= render "bulk_imports/header" %>
  <section class="bulk-import" aria-labelledby="bulk-import-title">
    <h2 class="bulk-import__title" id="bulk-import-title"><%= bulk_import_title %></h2>
    <%= render "bulk_imports/steps", current: :done %>
    <p class="bulk-import__lead"><%= @result["count"] %>冊を「<%= Book.status.find_value(@result["status"])&.text %>」で登録しました。</p>
    <div class="bulk-import__actions">
      <%= link_to "続けて登録する", url_for(action: :new), class: "button" %>
      <%= link_to "本棚へ戻る", root_path, class: "button button--primary" %>
    </div>
  </section>
</div>
