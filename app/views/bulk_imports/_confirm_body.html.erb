<div class="page">
  <%= render "bulk_imports/header" %>
  <section class="bulkImport" aria-labelledby="bulk-import-title">
    <h2 class="bulkImport__title" id="bulk-import-title"><%= bulk_import_title %></h2>
    <%= render "bulk_imports/steps", current: :confirm %>
    <% if @form.errors.any? %>
      <div class="banner" role="alert">
        <% @form.errors.full_messages.each do |message| %>
          <div><%= message %></div>
        <% end %>
      </div>
    <% end %>
    <%= form_with url: url_for(action: :create), method: :post, class: "bulkImport__confirm" do %>
      <% @user_shelf_items_attributes.each_with_index do |attributes, index| %>
        <% attributes.except("tags").each do |key, value| %>
          <%= hidden_field_tag "user_shelf_items[#{index}][#{key}]", value, id: nil %>
        <% end %>
        <% Array(attributes["tags"]).each do |tag| %>
          <%= hidden_field_tag "user_shelf_items[#{index}][tags][]", tag, id: nil %>
        <% end %>
      <% end %>
      <p class="bulkImport__lead">次の<%= @form.user_shelf_items.size %>冊を登録します。登録するときの状態を選んでください。</p>
      <label class="bulkImport__status">
        <span>登録するときの状態</span>
        <%= select_tag :status, bulk_import_status_options(@status), class: "bulkImport__select" %>
      </label>
      <ol class="bulkReview">
        <% @form.user_shelf_items.each do |user_shelf_item| %>
          <li class="bulkReview__item">
            <div class="bulkReview__body">
              <div class="bulkReview__source bulkReview__source--title"><%= user_shelf_item.title.presence || "ISBN #{user_shelf_item.isbn13}" %></div>
              <span class="bulkReview__note"><%= bulk_import_user_shelf_item_detail(user_shelf_item) %></span>
            </div>
          </li>
        <% end %>
      </ol>
      <div class="bulkImport__actions">
        <button class="button" type="button" onclick="history.back()">戻る</button>
        <%= button_tag "#{@form.user_shelf_items.size}冊を登録する", class: "button button--primary", disabled: @form.errors.any? %>
      </div>
    <% end %>
  </section>
</div>
