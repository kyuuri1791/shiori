create_table "edition_identifiers", force: :cascade do |t|
  t.bigint "edition_id", null: false
  t.string "scheme", null: false
  t.string "value", null: false
  t.timestamps
  t.index [ "scheme", "value" ], unique: true
  t.index [ "edition_id" ]
end
add_foreign_key "edition_identifiers", "editions"
add_check_constraint "edition_identifiers", "scheme::text <> 'isbn13'::text OR value::text ~ '^97[89][0-9]{10}$'::text", name: "edition_identifiers_isbn13_format"
