create_table "ai_searches", force: :cascade do |t|
  t.bigint "user_id", null: false
  t.string "query", null: false
  t.integer "status", null: false, default: 1
  t.jsonb "interpretation"
  t.string "interpreter_version"
  t.bigint "edition_ids", array: true, null: false, default: []
  t.string "error_message"
  t.integer "input_tokens"
  t.integer "output_tokens"
  t.timestamps
  t.index [ "user_id", "created_at" ]
  t.index [ "query", "interpreter_version", "created_at" ]
  t.index [ "created_at" ]
end
add_foreign_key "ai_searches", "users"
add_check_constraint "ai_searches", "status = ANY (ARRAY[1, 2, 3])", name: "ai_searches_status_range"
